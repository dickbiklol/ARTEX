# Docker 部署配置（复制为 .env）
# 镜像由本地源码构建（Dockerfile.source），这个名字只是本地 tag，不会去 pull。
ARTEX_TAG=local
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex
# Postgres 在宿主机上的端口（只绑 127.0.0.1；容器内部始终 5432）。
# 同一台机器装第二套 ARTEX 时改成别的（如 5434），否则宿主机会端口冲突。
POSTGRES_HOST_PORT=5433

# 面板端口（宿主机）。install.sh 会提示你选择；容器内始终监听 8787。
ARTEX_PORT=8787
# 流量录制代理端口（只绑 127.0.0.1，供 curl/pwntools 等回环通过它出网并被记录）。
ARTEX_PROXY_PORT=8788

# 从源码构建时用（预构建镜像不可用 / 想自己改代码）：
#   docker compose up -d --build
# context 必须是【源码目录】，install.sh 会自动写好。
ARTEX_BUILD_CONTEXT=.
ARTEX_DOCKERFILE=Dockerfile.source
ARTEX_VERSION=dev

# 镜像构建开关（改了要重新 build）
WITH_SCANNERS=true
INSTALL_NUCLEI_TEMPLATES=false
INSTALL_SECLISTS=false
INSTALL_EXPLOITDB=false

# 私有 GitHub Release 更新（仅后端读取；令牌需 Hinln/ARTEX 的 Contents: read）
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 带外回调（OOB）——验证「盲」类漏洞的唯一手段
#
# 盲 SSRF / 盲 XXE / 盲 SQLi / 盲目命令注入 / Log4j(JNDI) / 后端抓取型盲 XSS：
# 攻击连接上永远没有回显。没有回调，这些只能记为 inferred，等于系统性漏报这一类。
#
# 默认后端是公共 dnslog.cn，无需任何自建服务；但需要容器能出网访问它。
# 出网受限、或用自建回调服务（interactsh / 自建 dnslog）时，改下面两项：

# 自建/替代回调服务地址（留空 = 用默认 dnslog.cn）
# 例：ARTEX_OOB_BASE_URL=https://oob.example.com
ARTEX_OOB_BASE_URL=

# 完全隔离的部署（不允许任何出网）设为 1：工具仍存在，但会明确返回
# "OOB 不可用"，worker 会把这个方向记为 inferred 而不是默默丢掉。
ARTEX_OOB_DISABLED=

# 注意：回调客户端【不走】ARTEX_LLM_PROXY，也不走录制代理——这些请求是我们自己发的，
# 不属于目标流量，绝不能混进 traffic 记录里。
